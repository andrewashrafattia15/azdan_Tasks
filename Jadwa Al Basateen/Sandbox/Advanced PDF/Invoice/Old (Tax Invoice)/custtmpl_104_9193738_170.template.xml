<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <link name="NotoSansArabic" type="font" subtype="opentype" src="${nsfont.NotoSansArabic_Regular}" src-bold="${nsfont.NotoSansArabic_Bold}" bytes="2" subset="false" />
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            <table class="header" style="width: 100%;">
              <tr>
                <#if subsidiary.logo@url != "" >
                <td  align="left" style="width: 30%; padding-top: -25px"> <img src="${subsidiary.logo@url}" style="float: left; width:150px; height:75px" /></td>
                <#else>
                <td align="left" style="width: 30%; padding-top: -25px"></td>
                </#if>
                <td align="center" style="width: 50%;font-size: 10pt; font-weight:bold; padding-left:px; padding-top:25px">Tax Invoice / فاتورة ضريبية </td>
                <!-- <td align="right" style="width:20%"></td> -->
                <td align="right" style="width:20%" ><barcode codetype="qrcode" showtext="true" height="80" width="80" value="${record.custbody_az_trx_base64}" /></td>

              </tr>
            </table>
        </macro>
      
    </macrolist>
   <style type="text/css">* {
            <#if .locale == "zh_CN">
                font-family: NotoSans, NotoSansCJKsc, sans-serif;
            <#elseif .locale == "zh_TW">
                font-family: NotoSans, NotoSansCJKtc, sans-serif;
            <#elseif .locale == "ja_JP">
                font-family: NotoSans, NotoSansCJKjp, sans-serif;
            <#elseif .locale == "ko_KR">
                font-family: NotoSans, NotoSansCJKkr, sans-serif;
            <#elseif .locale == "th_TH">
                font-family: NotoSans, NotoSansThai, sans-serif;
            <#else>
                font-family: NotoSans, sans-serif;
                  font-family: NotoSansArabic, sans-serif;
            </#if>
            }
      .arabic {
        font-family: arabic-font;
        position: right;
        font-size: 8px;
        line-height: 75%;
      }

        .english {
        font-family: english-font;
        position: left;
        font-size: 8px;
        line-height: 110%
      }
  </style>
</head>
<body header="nlheader" header-height="10%"  padding="0.5in 0.5in 0.5in 0.5in" size="A4">
<table style="width:100%" >
  <tr>

     <td align="left" style="width:50%">
       
       <table style="width:100%" >
         <tr style="width: 100%; background-color: #d2d2d2;">
           <td align="left" style="width:100% ;font-weight:bold"> Buyer:</td>
         </tr>
        </table>
       
        <table style="width:100%; font-size:8pt; ">
          <tr style="">
            <td style="width:40%; font-weight:bold; ">  Customer Code: <br/> رقم العميل  </td>
            <td style="width:60%; " > ${record.entity.entityid}</td>
          </tr>
          <tr style="padding-top:10px">
             <td style="font-weight:bold; ">Customer Name:</td>
             <td>    ${record.entity.custentity_az_bas_customer_name} </td>
          </tr>
          <tr style="padding-top:-5px">
            <td style="font-weight:bold">اسم العميل</td>
            <td>  ${record.entity.custentity_ino_pms_arabic_name} </td>
          </tr>
          <tr style="padding-top:10px">
            <td style="font-weight:bold;">Address: <br/> العنوان </td>
            <td> ${record.entity.address}</td>
          </tr>
          <tr style="padding-top:10px">
            <td style="font-weight:bold ;"> Customer VAT #: <br/> الرقم الضريبي للعميل </td>
            <td> ${record.entity.vatregnumber} </td>
          </tr>
          <tr style="padding-top:10px">
            <td style="font-weight:bold; padding-top:5px"> Invoice Number: <br/> رقم الفاتورة </td>
             <td>  ${record.tranid}</td>
          </tr>
         <tr style="padding-top:10px">
           <td style="font-weight:bold ;">Invoice Date: <br/> تاريخ الفاتورة</td>
           <td style=" padding-left:px"> ${record.trandate?string("M/d/yyyy")}</td>
         </tr>
        <tr style="padding-top:10px">
          <td style="font-weight:bold ;">Due Date: <br/>  تاريخ الاستحقاق </td>
          <td style=" padding-left:px"> ${record.duedate?has_content?then(record.duedate?string("M/d/yyyy")," ")}</td>
        </tr>
        </table>
      </td>
                      


    <td align="right" style="width:50%">
        
       <table style="width:100%" >
         <tr style="width: 100%; background-color: #d2d2d2;">
           <td align="left" style="width:100% ;font-weight:bold"> Seller:</td>
         </tr>
        </table>
        
        <table style="width:100%; font-size:8pt; ">
          <tr>
            <td align="left" style="width:50%; font-weight:bold; ">Company Name: <br/> اسم الشركة </td>
            <td align="right" style="width:50%; padding-left:px "> ${record.subsidiary.legalname}</td>
          </tr>
          <tr style="padding-top:10px">
             <td style="font-weight:bold;">Group Vat Number: <br/> رقم المجموعة الضريبية </td>
             <td  style="padding-left:px">${record.subsidiary.custrecord_az_bas_group_vat_number}</td>
          </tr>
          <tr style="padding-top:10px">
            <td style="font-weight:bold ;">Address: <br/> العنوان</td>
             <td style="padding-left:px"> ${subsidiary.mainaddress_text}</td>
          </tr>
          <tr style="padding-top:10px">
            <td style="font-weight:bold ;"> VAT Number: <br/>الرقم الضريبي</td>
            <td style="padding-left:px"> ${subsidiary.federalidnumber} </td>
          </tr>
          <tr style="padding-top:10px">
            <td style="font-weight:bold ;"> CMA: <br/> هيئة السوق المالية</td>
            <td style="padding-left:px"> ${record.subsidiary.custrecord_az_bas_subs_cma_num}</td>
          </tr>
        </table>
      </td>         
    </tr>
      

</table>




  <!--start items-->
  <table style="width: 100%; margin-top: 20px; border: 1px solid #808080; font-size: 8pt;">
    <tr style="background-color:#d2d2d2; font-size: 10px; font-weight: bold;">
      <td style="width:30%; font-weight:bold"> Line Items:</td>
      <td style="width:10%"></td>
      <td style="width:10%"></td>
      <td style="width:10%"></td>
      <td style="width:10%"></td>
      <td style="width:10%"></td>
      <td style="width:20%"></td>
    </tr>
    
    <tr style="background-color:#d2d2d2; font-size: 8px;">
      <td align="left" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> <p> Nature of Goods or Services </p> <p> <strong> الوصف</strong>  </p></td>
      <td align="center" style="border-top: 1px solid #808080;border-right: 1px solid #808080 ; padding-bottom:10px "> <p> Unit Price</p>  <p> <strong> سعر الوحدة</strong> </p> </td>
      <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px "> <p> Quantity </p> <p> <strong> كمية</strong></p>  </td>
      <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px;"> <p> Taxable  </p> <p style="padding-top:-5px;">Amount </p>  <p> <strong> المبلغ الخاضع </strong> </p> <p><strong> للضريبة</strong></p></td>
      <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080; padding-bottom:10px "> <p> Tax Rate</p>   <p><strong> نسبة الضريبة </strong> </p> </td>
      <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> <p> Tax Amount</p>   <p> <strong>قيمة الضريبة </strong> </p> </td>
      <td align="center" style="border-top: 1px solid #808080; padding-bottom:10px "> <p> Item Subtotal </p> <p style="padding-top:-5px"> (Including VAT)</p>   <p> <strong> الاجمالي شامل ضريبة</strong> </p> <p> <strong>  القيمة المضافة</strong></p> </td>
    </tr>

   <#if record.item?has_content>
     <#list record.item as item>
      <tr style="font-size:8pt">
        <td align="left" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> ${item.description}</td>
        <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> ${item.rate?string(",##0.00")}</td>
        <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> ${item.quantity}</td>
        <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> ${item.amount?string(",##0.00")}</td>
        <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> ${item.taxrate1}</td>
        <td align="center" style="border-top: 1px solid #808080; border-right: 1px solid #808080 ; padding-bottom:10px"> ${item.tax1amt?string(",##0.00")}</td>
        <td align="center" style="border-top: 1px solid #808080; padding-bottom:10px"> ${item.grossamt?string(",##0.00")}</td>
     </tr>
   </#list>
  </#if>
</table>

   <table style="width: 100%; margin-top: 20px; border: 1px solid #e2e2e2; font-size: 8pt;">
     <#if record.custpage_az_ats_amount_word_ar_fld?has_content>
       <#assign totalwords_ar = record.custpage_az_ats_amount_word_ar_fld>
     <#else>
       <#assign totalwords_ar = ' '>
     </#if>

    <#if record.custpage_az_ats_amount_word_fld?has_content>
       <#assign totalwords_en = record.custpage_az_ats_amount_word_fld>
     <#else>
       <#assign totalwords_en = ' '>
     </#if>
      
     <tr style="background-color:#e2e2e2; font-size: 10px;">
       <td style="width:30%; font-weight:bold"> Total Amount</td>
       <td style="width:40%;"></td>
       <td style="width:30%;"></td>
     </tr>

     <tr style="font-size:8pt">
       <td align="left" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ; font-weight:bold"> Sub Total:</td>
       <td align="center" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2;"> ${record.subtotal?string(",##0.00")}</td>
       <td align="right" style="border-top: 1px solid #e2e2e2; font-weight:bold"> : الاجمالي</td>
     </tr>

    <tr style="font-size:8pt">
       <td align="left" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2; font-weight:bold"> Vat Value:</td>
       <td align="center" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ;"> ${record.taxtotal?string(",##0.00")}</td>
       <td align="right" style="border-top: 1px solid #e2e2e2; font-weight:bold">  : قيمة الضريبة  </td>
     </tr>

      <tr style="font-size:8pt">
       <td align="left" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ; font-weight:bold">Total Amount With VAT:</td>
       <td align="center" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ;"> ${record.total?string(",##0.00")}</td>
       <td align="right" style="border-top: 1px solid #e2e2e2; font-weight:bold"> : الاجمالي متضمن قيمة الضريبة  </td>
     </tr>

      <tr style="font-size:8pt">
       <td align="left" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ; font-weight:bold">Amount in Arabic Words:</td>
       <td align="center" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ;"> <p align="center"> ${totalwords_ar}  </p> </td>
       <td align="right" style="border-top: 1px solid #e2e2e2; font-weight:bold"> : القيمة كتابة باللغة العربية   </td>
     </tr>

     <tr style="font-size:8pt">
       <td align="left" style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ; font-weight:bold">Amount in Words:</td>
       <td  style="border-top: 1px solid #e2e2e2; border-right: 1px solid #e2e2e2 ;"> <p align="center">${totalwords_en} </p> </td>
       <td align="right" style="border-top: 1px solid #e2e2e2; font-weight:bold">  : القيمة كتابة باللغة الانجليزية   </td>
     </tr>
     
   </table>
  <hr style="height:8px; border-width:0; width: 100%; color:#646464; background-color:#646464; "/>
  
       <table style="width: 100%;font-size:10pt; margin-top: 20px " > 
              <tr>
                 <td align="left" style=""> <strong> Bank Name:</strong>  ${record.subsidiary.custrecord_az_bas_bank_name}</td>
               </tr>
              <tr>
                <td align="left" style=""><strong>  Branch:</strong>  ${record.subsidiary.custrecord_az_bas_branch}</td>
              </tr>
              <tr>
                <td align="left" style=""> <strong> A/C Title:</strong> ${record.subsidiary.custrecord_az_bas_ac_title}</td>
              </tr>
              <tr>
                <td align="left" style=""> <strong> A/C Number:</strong> ${record.subsidiary.custrecord_az_bas_ac_number}</td>
              </tr>
              <tr>
                <td align="left" style=""> <strong> IBAN:</strong>  ${record.subsidiary.custrecord_az_bas_iban}</td>
              </tr>
            </table>

</body>
</pdf>